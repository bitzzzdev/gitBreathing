{
  "name": "gitbreathing",
  "version": "1.1.0",
  "description": "Deterministic contribution-powered animated ASCII breathing-style art for GitHub and GitLab profiles",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "render": "tsx scripts/render.ts",
    "render:preview": "CONTRIBUTIONS=1200 tsx scripts/render.ts",
    "render:profile": "tsx scripts/profile.ts",
    "test": "node --test tests/*.test.mjs",
    "profile:fetch": "node scripts/fetch-gitlab-profile.mjs"
  },
  "dependencies": {
    "ascii.rest": "^0.4.0",
    "gifenc": "^1.0.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.2",
    "typescript": "~5.7.2",
    "vite": "^6.0.5"
  }
}
